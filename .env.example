# Read DASHSCOPE_API_KEY from the system environment. Do not commit real keys.
# DashScope is selected automatically when DASHSCOPE_API_KEY is present.
# MODEL_PROVIDER=dashscope
DASHSCOPE_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4.1-flash
DASHSCOPE_VISION_MODEL=deepseek-v4.1-flash
# Wan video synthesis and task-query API; the key stays in the backend environment.
DASHSCOPE_VIDEO_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1

# Optional legacy provider (set MODEL_PROVIDER=aihubmix to explicitly select it)
AIHUBMIX_API_KEY=replace_with_your_key
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_MODEL=deepseek-v4.1-flash-1017
AIHUBMIX_VISION_MODEL=gpt-4o
